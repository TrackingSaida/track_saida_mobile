{
  "expo": {
    "name": "Tracking Sa\u00eddas",
    "slug": "track_saida_mobile",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "trackingsaida",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso \u00e0 c\u00e2mera para escanear c\u00f3digos de entrega"
        }
      ],
      "expo-speech-recognition",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usar Face ID para entrar no app"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localiza\u00e7\u00e3o para navega\u00e7\u00e3o durante as entregas.",
          "locationAlwaysAndWhenInUsePermission": "Usamos sua localiza\u00e7\u00e3o mesmo em segundo plano para acompanhar a rota ativa.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.track-saida-mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSLocationWhenInUseUsageDescription": "Usamos sua localiza\u00e7\u00e3o para navega\u00e7\u00e3o durante as entregas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Usamos sua localiza\u00e7\u00e3o mesmo em segundo plano para acompanhar a rota ativa."
      },
      "backgroundModes": [
        "location"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "br.com.trackingsaidas.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e3e08c21-f540-4b5a-848b-334b34c03148"
      }
    },
    "owner": "acsilva"
  }
}
